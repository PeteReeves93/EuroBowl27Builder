# ---- Copy this file to ".env" and fill in the values. Never commit .env ----

# --- Postgres (Supabase) ---
# IMPORTANT: on Vercel you must use the POOLER host (aws-0-<region>.pooler.supabase.com),
# NOT the direct host (db.<ref>.supabase.co) — the direct host is IPv6-only and Vercel
# cannot reach it. The pooler username is "postgres.<project-ref>".
# Easiest: Supabase dashboard -> "Connect" (top bar) -> ORMs -> Prisma. It gives both
# URLs ready-made; just append &schema=eurobowl to each (they already start with "?").

# DATABASE_URL = Transaction pooler (port 6543) — used at runtime.
DATABASE_URL="postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=eurobowl"

# DIRECT_URL = Session pooler (port 5432) — used by `prisma db push` at build time.
DIRECT_URL="postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=eurobowl"

# ---- NextAuth / Auth.js ----
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="CHANGE_ME"
# In production set this to your Vercel URL, e.g. https://eurobowl27.vercel.app
AUTH_URL="http://localhost:3000"

# ---- Discord OAuth application ----
# From https://discord.com/developers/applications  ->  your app  ->  OAuth2
# Redirect URL to register there:  {AUTH_URL}/api/auth/callback/discord
AUTH_DISCORD_ID="YOUR_DISCORD_CLIENT_ID"
AUTH_DISCORD_SECRET="YOUR_DISCORD_CLIENT_SECRET"

# ---- Access control defaults (can be overridden live in the admin page) ----
# The Discord server (guild) ID whose members are auto-approved on first login.
AUTO_ADMIT_GUILD_ID=""
# Discord IDs (comma separated) that should be seeded as ADMIN on first login.
# Put YOUR Discord user ID here so you can reach the admin page.
ADMIN_DISCORD_IDS=""
