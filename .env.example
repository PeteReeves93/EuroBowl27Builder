# ---- Copy this file to ".env" and fill in the values. Never commit .env ----

# --- Postgres (Supabase) ---
# DATABASE_URL = POOLED connection (used at runtime by serverless functions).
#   Supabase: Project Settings > Database > Connection string > "Transaction pooler"
#   (port 6543). Append pgbouncer=true. Keep &schema=eurobowl to isolate from Fall Cup.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true&schema=eurobowl"

# DIRECT_URL = DIRECT connection (used by `prisma db push` at build time).
#   Supabase: same page > "Direct connection" (port 5432). Same &schema=eurobowl.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&schema=eurobowl"

# ---- NextAuth / Auth.js ----
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="CHANGE_ME"
# In production set this to your Vercel URL, e.g. https://eurobowl27.vercel.app
AUTH_URL="http://localhost:3000"

# ---- Discord OAuth application ----
# From https://discord.com/developers/applications  ->  your app  ->  OAuth2
# Redirect URL to register there:  {AUTH_URL}/api/auth/callback/discord
AUTH_DISCORD_ID="YOUR_DISCORD_CLIENT_ID"
AUTH_DISCORD_SECRET="YOUR_DISCORD_CLIENT_SECRET"

# ---- Access control defaults (can be overridden live in the admin page) ----
# The Discord server (guild) ID whose members are auto-approved on first login.
AUTO_ADMIT_GUILD_ID=""
# Discord IDs (comma separated) that should be seeded as ADMIN on first login.
# Put YOUR Discord user ID here so you can reach the admin page.
ADMIN_DISCORD_IDS=""
